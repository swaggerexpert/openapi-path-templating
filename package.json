{
  "name": "openapi-path-templating",
  "version": "2.3.0",
  "description": "OpenAPI Path Templating parser, validator, resolver and matcher.",
  "main": "./cjs/index.cjs",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/openapi-path-templating.browser.min.js",
  "jsdelivr": "./dist/openapi-path-templating.browser.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "watch": {
    "test": "{src,test}/*.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "grammar:compile": "node ./scripts/apg-js.js --lite --in=./src/grammar.bnf --out=./src/grammar.js && node ./scripts/apg-js.js --lite --in=./src/uri-template/grammar.bnf --out=./src/uri-template/grammar.js",
    "build": "npm run grammar:compile && npm run build:es && npm run build:cjs && npm run build:cjs:apg-lite && npm run build:umd:browser",
    "build:es": "cross-env BABEL_ENV=es babel src --out-dir es --extensions '.js' --out-file-extension '.mjs'",
    "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir cjs --extensions '.js' --out-file-extension '.cjs'",
    "build:cjs:apg-lite": "cross-env BABEL_ENV=cjs babel node_modules/apg-lite/lib/parser.js --out-file ./cjs/apg-lite.cjs",
    "build:umd:browser": "cross-env BABEL_ENV=browser webpack --config config/webpack/browser.config.js --progress",
    "test": "mocha",
    "test:watch": "npm-watch test",
    "watch": "npm-watch"
  },
  "engines": {
    "node": ">=12.20.0"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/swaggerexpert/openapi-path-templating.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "keywords": [
    "openapi",
    "path",
    "templating",
    "parser",
    "validator",
    "resolver",
    "matcher",
    "matching"
  ],
  "author": "Vladimír Gorej <vladimir.gorej@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/swaggerexpert/openapi-path-templating/issues"
  },
  "homepage": "https://github.com/swaggerexpert/openapi-path-templating#readme",
  "files": [
    "es/",
    "cjs/",
    "dist/",
    "types/",
    "LICENSE",
    "NOTICE",
    "package.json",
    "README.md",
    "SECURITY.md"
  ],
  "dependencies": {
    "apg-lite": "^1.0.5"
  },
  "devDependencies": {
    "@babel/cli": "=7.28.6",
    "@babel/core": "=7.29.0",
    "@babel/preset-env": "=7.29.0",
    "@commitlint/cli": "=20.5.0",
    "@commitlint/config-conventional": "=21.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "apg-js": "^4.4.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "chai": "=6.2.2",
    "cross-env": "^10.0.0",
    "husky": "=9.1.7",
    "mocha": "=12.0.3",
    "npm-watch": "^0.13.0",
    "prettier": "^3.1.1",
    "semantic-release": "^25.0.9",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  }
}
